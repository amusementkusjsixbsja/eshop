# ============================================
# 电商平台 — 环境变量模板
# 复制为 .env 并填入实际值
# ============================================

# 数据库
DATABASE_URL=postgresql://user:1234@postgres:5432/agent
# 注意: 内部容器用 postgres:5432，宿主机外部访问用 localhost:5433
POSTGRES_DB=agent
POSTGRES_USER=user
POSTGRES_PASSWORD=1234

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION_HOURS=24

# 服务间内部调用
INTERNAL_API_TOKEN=dev-internal-token

# 日志级别
LOG_LEVEL=INFO
